# Para executar localmente, copie este arquivo para .env e preencha:
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/amora_beauty
SESSION_SECRET=coloque-uma-chave-grande-e-aleatoria
NODE_ENV=development

# Cloudinary: necessário para as fotos continuarem disponíveis no Render
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
